# Development only. Production refuses this mode.
AUTH_MODE=development
DEV_USER_ID=alex
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Local files are allowed only outside production. Netlify uses blobs.
STORAGE_DRIVER=local
BLOB_STORE_NAME=grants-development
UPLOAD_DIR=./data/uploads
APP_ORIGIN=http://localhost:3000
# Production: configure these in Netlify, never commit credentials.
# AUTH_MODE=entra
# AUTH_URL=https://grant-dashboard.netlify.app
# APP_ORIGIN=https://grant-dashboard.netlify.app
# STORAGE_DRIVER=netlify
# BLOB_STORE_NAME=grants-production
# ENTRA_TENANT_ID=your-directory-tenant-id
# ENTRA_CLIENT_ID=your-application-client-id
# ENTRA_CLIENT_SECRET=your-client-secret-value
# AUTH_SECRET=generate-a-cryptographically-random-secret
# Optional legacy gateway mode: AUTH_MODE=proxy, AUTH_JWT_SECRET,
# AUTH_ISSUER=rtfh-auth-proxy, AUTH_AUDIENCE=rtfh-grants.
