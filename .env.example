# Development only. Production refuses this mode.
AUTH_MODE=development
DEV_USER_ID=alex
DATABASE_PATH=./data/grants.sqlite
UPLOAD_DIR=./data/uploads
APP_ORIGIN=http://localhost:3000
# Production requires a trusted auth proxy that strips incoming x-rtfh-token,
# verifies Entra login, and issues short-lived signed JWTs for provisioned staff.
