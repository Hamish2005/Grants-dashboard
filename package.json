{
  "name": "rtfh-grants-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/setup.ts",
    "uploads:cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup.ts",
    "test:browser": "playwright test",
    "format": "prettier --write app components lib scripts tests docs README.md",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "next": "^16.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
